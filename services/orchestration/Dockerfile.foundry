FROM python:3.12-slim

WORKDIR /app

COPY . user_agent/
WORKDIR /app/user_agent

RUN if [ -f requirements.foundry.txt ]; then \
        pip install --no-cache-dir -r requirements.foundry.txt; \
    else \
        pip install --no-cache-dir -r requirements.txt; \
    fi

EXPOSE 8088

CMD ["python", "foundry_main.py"]
